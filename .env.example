# Local demonstration only. Never use these values outside this isolated workstation database.
NEXOGOV_DB_NAME=nexogov_dev
NEXOGOV_DB_USERNAME=nexogov_dev
NEXOGOV_DB_PASSWORD=nexogov-local-only
NEXOGOV_DB_PORT=55433
NEXOGOV_STORAGE_BUCKET=nexogov-private-documents
NEXOGOV_STORAGE_REGION=us-east-1
NEXOGOV_STORAGE_PORT=55434
NEXOGOV_STORAGE_ENDPOINT_URI=http://127.0.0.1:55434
# Local S3Mock only; replace with a managed private S3-compatible service outside development.
NEXOGOV_STORAGE_ACCESS_KEY=local-s3mock-access
NEXOGOV_STORAGE_SECRET_KEY=local-s3mock-secret
NEXOGOV_ATTACHMENT_MAX_FILES=10
NEXOGOV_ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
NEXOGOV_API_PORT=8081
NEXOGOV_WEB_PORT=9000
NEXOGOV_DEMO_USERNAME=servidor
NEXOGOV_DEMO_PASSWORD=troque-esta-senha-local
NEXOGOV_DEMO_MEMBER_USERNAME=servidor.teste
NEXOGOV_DEMO_MEMBER_PASSWORD=troque-esta-senha-local
NEXOGOV_PUBLIC_BASE_URL=http://localhost:9000
NEXOGOV_ALLOWED_ORIGIN=http://localhost:9000
# Production bearer authentication stays closed until all three trusted IdP values are configured.
NEXOGOV_IDENTITY_ISSUER_URI=
NEXOGOV_IDENTITY_JWK_SET_URI=
NEXOGOV_IDENTITY_AUDIENCE=
# Build-time staff client settings for a public OIDC client. Never add a client secret.
VITE_STAFF_AUTH_MODE=oidc
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_SCOPE=openid profile
