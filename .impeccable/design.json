        "html": "<article class=\"ds-record\"><span class=\"ds-record-number\">2026/000001</span><h3>Solicitação de atendimento</h3><p>Requerente · Setor responsável</p><span class=\"ds-status\">Recebido</span></article>",
        "css": ".ds-record{display:grid;gap:5px;padding:19px 0;border-top:1px solid #dce1e8}.ds-record-number{color:var(--nexo-color-action);font:700 12px/1.4 var(--nexo-font-body);letter-spacing:.035em}.ds-record h3{margin:0;color:var(--nexo-color-text);font:620 16px/1.4 var(--nexo-font-body)}.ds-record p{margin:0;color:var(--nexo-color-text-secondary);font:400 12px/1.5 var(--nexo-font-body)}.ds-status{color:var(--nexo-color-text-secondary);font:650 12px/1.4 var(--nexo-font-body)}"
