      {
        "name": "Primary Button",
        "kind": "button",
        "refersTo": "button-primary",
        "description": "A dark navy action for submitting or advancing a real task.",
        "html": "<button class=\"ds-button-primary\" type=\"button\">Registrar solicitação</button>",
        "css": ".ds-button-primary{min-height:44px;padding:0 17px;border:0;border-radius:7px;background:var(--nexo-color-navy);color:#fff;font:600 14px/1.2 var(--nexo-font-body);cursor:pointer}.ds-button-primary:hover{filter:brightness(.92)}.ds-button-primary:focus-visible{outline:none;box-shadow:var(--nexo-focus-ring)}@media(pointer:coarse){.ds-button-primary{min-height:48px}}"
      },
      {
        "name": "Outlined Field",
        "kind": "input",
        "refersTo": "field-outlined",
        "description": "A labeled input with a restrained outline and visible keyboard focus.",
        "html": "<label class=\"ds-field\"><span>Assunto *</span><input type=\"text\" autocomplete=\"off\"></label>",
        "css": ".ds-field{display:grid;gap:6px;color:var(--nexo-color-text-secondary);font:400 13px/1.4 var(--nexo-font-body)}.ds-field input{width:100%;min-height:44px;padding:0 12px;border:1px solid #c5cdd8;border-radius:7px;background:var(--nexo-color-surface);color:var(--nexo-color-text);font:inherit}.ds-field input:focus-visible{outline:none;border-width:2px;box-shadow:var(--nexo-focus-ring)}"
      },
      {
        "name": "Citizen Service Tabs",
        "kind": "nav",
        "refersTo": "tabs-active",
        "description": "Two labeled tasks switch between opening and tracking a public protocol.",
        "html": "<nav class=\"ds-tabs\" aria-label=\"Serviços de protocolo\"><a href=\"#nova\" class=\"ds-tab ds-tab-active\" aria-current=\"page\">Nova solicitação</a><a href=\"#acompanhar\" class=\"ds-tab\">Acompanhar protocolo</a></nav>",
        "css": ".ds-tabs{display:flex;gap:28px;border-bottom:1px solid #dce1e8}.ds-tab{position:relative;display:flex;min-height:50px;align-items:center;padding-right:20px;color:var(--nexo-color-text-secondary);font:550 14px/1.4 var(--nexo-font-body);text-decoration:none}.ds-tab-active{color:var(--nexo-color-navy);font-weight:650}.ds-tab-active:after{position:absolute;right:20px;bottom:0;left:0;height:2px;background:var(--nexo-color-primary);content:\"\"}.ds-tab:focus-visible{outline:none;box-shadow:var(--nexo-focus-ring)}"
      },
      {
        "name": "Guidance Margin",
        "kind": "custom",
        "refersTo": "service-aside",
        "description": "Short, factual guidance sits beside the citizen form and links to protocol tracking.",
        "html": "<aside class=\"ds-guidance\"><h2>Guarde o comprovante</h2><p>Ele contém o número e a chave para consultar as movimentações.</p><hr><a href=\"#acompanhar\">Já tenho um protocolo</a></aside>",
        "css": ".ds-guidance{max-width:264px;padding-left:27px;border-left:1px solid #d6dce5}.ds-guidance h2{margin:0 0 9px;color:var(--nexo-color-text);font:620 22px/1.18 var(--nexo-font-body);letter-spacing:-.035em}.ds-guidance p{margin:0;color:var(--nexo-color-text-secondary);font:400 13px/1.65 var(--nexo-font-body)}.ds-guidance hr{margin:21px 0 19px;border:0;border-top:1px solid #dce1e8}.ds-guidance a{color:var(--nexo-color-action);font:650 13px/1.4 var(--nexo-font-body);text-underline-offset:3px}.ds-guidance a:focus-visible{outline:none;box-shadow:var(--nexo-focus-ring)}"
      },
