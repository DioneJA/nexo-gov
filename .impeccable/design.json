    "narrative": {
      "northStar": "Civic Register",
      "overview": "NexoGov is a public-service workbench, presented as a clear municipal record rather than a generic SaaS dashboard. The request or protocol leads the page; its actual status and next action remain easy to find. The Apple Human Interface Guidelines inform clarity, alignment, restrained color, and straightforward controls while NexoGov retains its own identity.\n\nThe product uses a text wordmark and two separate application entry points: a public citizen portal and an authenticated staff work area. They share neutral tokens, API clients, and contracts, but keep distinct navigation and tasks. A flat layout, functional dividers, system typography, and real workflow copy replace decorative badges and repeated cards.",
      "keyCharacteristics": [
        "Text-first NexoGov wordmark without an isolated initial tile.",
        "Navy for primary actions, with NEXO blue for selected emphasis and links.",
        "Two purpose-specific frontends over one permission-enforcing API."
      ],
      "rules": [
        {
          "name": "The Civic Register Rule",
          "body": "Put the person's current task first, show the record's actual state, and use layout only to clarify the next action.",
          "section": "overview"
        },
        {
          "name": "The No Badge Rule",
          "body": "Use the product wordmark as text; do not invent a boxed initial or civic emblem.",
          "section": "overview"
        },
        {
          "name": "The One Accent Rule",
          "body": "Keep most surfaces neutral. Use NEXO navy for primary actions and NEXO blue for links or selected emphasis.",
          "section": "overview"
        }
      ],
      "dos": [
        "Do use the system UI stack and the NEXO Core token package.",
        "Do keep citizen and staff interfaces as separate application entry points.",
        "Do provide readable labels, visible keyboard focus, and reduced-motion support.",
        "Do show only workflows, statuses, and data the application provides."
      ],
      "donts": [
        "Don't use Apple logos, proprietary font files, SF Symbols, or Apple-specific interface chrome.",
        "Don't add boxed initials, eyebrow labels, repeated cards, decorative gradients, or stock civic symbols.",
        "Don't add unimplemented modules, invented metrics, municipal records, or unsupported claims.",
        "Don't use color as the only indicator of status, success, or error."
      ]
    }
  }
